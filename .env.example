# Copy this to .env and fill in your values
# Azure Document Intelligence (formerly Form Recognizer)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-key>

# Redis — points to the redis container defined in docker-compose.yml
# "redis" is the docker-compose service name, which Docker resolves as a hostname
REDIS_URL=redis://redis:6379

# PostgreSQL — points to the db container defined in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/invoice_db

# Microsoft Entra ID — from your App Registration in Azure Portal
AZURE_TENANT_ID=<your-directory-tenant-id>
AZURE_CLIENT_ID=<your-application-client-id>
AZURE_CLIENT_SECRET=<your-client-secret-value>

# App settings
APP_ENV=development
# Set to true to automatically apply Alembic migrations on container startup during local dev
RUNNING_LOCAL=true
